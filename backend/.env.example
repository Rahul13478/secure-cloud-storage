PROJECT_NAME=Secure Cloud Storage

# format: postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# make a random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRECT_KEY=change-me

# AES key as 64 hex characters (32 bytes). Make it the same way:
# python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=change-me-64-hex-characters

# local test storage (moto). For a real bucket, use the provider's values.
S3_ENDPOINT=http://127.0.0.1:5000
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
S3_BUCKET=secure-cloud-files

EMAIL_SENDER=you@example.com
# Gmail app password (not your normal password)
EMAIL_PASSWORD=your-app-password